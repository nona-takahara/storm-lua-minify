{
  "name": "storm-lua-minify",
  "description": "A Lua minifier also outputs source map",
  "version": "0.3.0",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "commander": "^12.1.0",
    "luaparse": "^0.3.1",
    "source-map": "^0.7.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/luaparse": "^0.2.13",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  },
  "bin": "dist/cli.js",
  "scripts": {
    "start": "node ./dist/cli.js",
    "build": "tsc",
    "test": "tsc -p tsconfig.eslint.json && npx vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:lua-budget": "node scripts/verify-lua-resource-budget.cjs",
    "prepack": "pnpm run build"
  },
  "author": "Nona Takahara <nona_t_2612@yahoo.co.jp>",
  "license": "MIT"
}
